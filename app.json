{
  "expo": {
    "name": "Care Games +",
    "slug": "my-expo-app",
    "version": "1.0.0",
    "scheme": "my-expo-app",
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a1929"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "newArchEnabled": false
          }
        }
      ],
      [
        "react-native-health-connect",
        {
          "rationaleActivity": ".MainActivity"
        }
      ],
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinicius.caregames",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Care Games + precisa de acesso aos seus passos e frequência cardíaca para sincronizar os dados de saúde com seus desafios e recompensas."
      }
    },
    "android": {
      "package": "com.vinicius.caregames",
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1929"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a60c3fdd-2a2b-4c47-9ca7-e71a7fdbf3c9"
      }
    }
  }
}
